# Rename this file to `.env` and replace the placeholder values

# Telegram bot token obtained from @BotFather
BOT_TOKEN="PASTE_YOUR_TELEGRAM_BOT_TOKEN_HERE"

# Chat ID of the private Telegram group where runners will receive order notifications
# For supergroups this usually starts with a minus sign e.g. -1001234567890
RUNNER_GROUP_ID="-100XXXXXXXXXX"